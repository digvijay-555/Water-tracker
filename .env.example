# WaterSaathi Environment Variables Example

# Frontend Web App Configuration (apps/web)
VITE_API_BASE_URL=http://localhost:3001
VITE_USE_MOCK_API=true

# Backend Configuration (backend)
PORT=3001
AWS_REGION=ap-south-1
TANKERS_TABLE=WaterSaathi-Tankers
REQUESTS_TABLE=WaterSaathi-Requests
BOOKINGS_TABLE=WaterSaathi-Bookings
REPORTS_TABLE=WaterSaathi-ShortageReports
NODE_ENV=development
# WaterSaathi Environment Configuration

# Toggle mock API mode (true = use in-memory mock client, false = use HTTP API Gateway)
VITE_USE_MOCK_API=true

# API Gateway Base URL (used when VITE_USE_MOCK_API is false)
VITE_API_BASE_URL=http://localhost:3001

# AWS Region (for deployment)
AWS_REGION=ap-south-1
